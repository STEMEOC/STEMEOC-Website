# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://stemeoc:stemeoc@localhost:5433/stemeoc?schema=public"

# Redis (caching + rate limiting)
REDIS_URL="redis://localhost:6379"

# Auth.js
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-generated-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google Sheets export (optional). An OAuth "Web application" client ID from
# Google Cloud with the Google Sheets API enabled. Without it, "Export > Google
# Sheets" falls back to copy-and-paste.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
